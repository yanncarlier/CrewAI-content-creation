# OPENAI_API_BASE=http://localhost:8080/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENAI_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/openrouter/free
OPENROUTER_API_KEY=your_openrouter_api_key_here

# X.com (Twitter) API Configuration - OAuth 1.0a User Context (Read + Write)
# To get your credentials:
# 1. Go to https://developer.x.com/en/portal/dashboard
# 2. Create a project and app
# 3. Under "Keys and tokens" tab, generate:
#    - API Key -> X_API_KEY
#    - API Key Secret -> X_API_SECRET
#    - Access Token -> X_ACCESS_TOKEN
#    - Access Token Secret -> X_ACCESS_TOKEN_SECRET
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Auto-post to X after content creation (true/false)
AUTO_POST_TO_X=false
